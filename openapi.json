              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "organizationId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "builtIn": {
                                  "type": "boolean",
                                  "enum": [
                                    true
                                  ]
                                },
                                "id": {
                                  "type": "string",
                                  "enum": [
                                    "title",
                                    "description",
                                    "dueDate",
                                    "priority",
                                    "status",
                                    "tags"
                                  ]
                                },
                                "label": {
                                  "type": "string",
