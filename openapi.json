    "/organizations/{organizationId}/form-settings": {
      "get": {
        "summary": "Get the form settings",
        "description": "Returns the defaults if none were saved. Built-in fields missing from the saved settings are appended as their own rows.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "organizationId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The form settings",
